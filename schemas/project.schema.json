{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery framework project v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "kind",
    "owner",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    }
  }
}
