#!/bin/bash
set -euo pipefail
exec > >(tee -a /var/log/memis-bootstrap.log) 2>&1

dnf upgrade --releasever=latest -y
dnf install -y nginx

cat > /etc/nginx/nginx.conf <<'NGINX'
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /run/nginx.pid;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/access.log;
    server_tokens off;
    server {
        listen 80 default_server;
        server_name ${domain_name};
        root /usr/share/nginx/html;
        location = /healthz {
            default_type text/plain;
            return 200 'ok\n';
        }
        location / { try_files $uri $uri/ =404; }
    }
}
NGINX

cat > /usr/share/nginx/html/index.html <<'HTML'
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${domain_name}</title></head>
<body><main><h1>${domain_name}</h1><p>The private Nginx reference service is running.</p><p>Business application and database integration are separate work.</p></main></body>
</html>
HTML

nginx -t
systemctl enable --now nginx
systemctl enable --now amazon-ssm-agent
